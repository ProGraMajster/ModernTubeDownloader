<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Authors>ProGraMajster</Authors>
    <Company>ProGraMajster</Company>
    <Copyright>Copyright (c) 2026 ProGraMajster</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ProGraMajster/ModernTubeDownloader</RepositoryUrl>

    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <WarningLevel>8</WarningLevel>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <ModernFormsNextCommit>1dce91b9740b3eba8d5f2f529017bebeffb88438</ModernFormsNextCommit>
    <ModernFormsNextRoot Condition="'$(ModernFormsNextRoot)' == ''">$(MSBuildThisFileDirectory).mfn-master-worktree</ModernFormsNextRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
