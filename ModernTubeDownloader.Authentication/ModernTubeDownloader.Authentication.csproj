<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The Windows PowerShell cookie probe loads the .NET 10 assembly in-process. -->
    <TargetFrameworks>net11.0-windows;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="ModernTubeDownloader.Tests" /></ItemGroup>
</Project>
